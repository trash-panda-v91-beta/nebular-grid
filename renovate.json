{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>trash-panda-v91-beta/renovate-config",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    "github>trash-panda-v91-beta/nebular-grid//.renovate/overrides.json",
    "github>trash-panda-v91-beta/nebular-grid//.renovate/groups.json",
    "github>trash-panda-v91-beta/nebular-grid//.renovate/autoMerge.json",
    "github>trash-panda-v91-beta/nebular-grid//.renovate/customManagers.json",
    "github>trash-panda-v91-beta/nebular-grid//.renovate/grafanaDashboards.json"
  ],
  "flux": {
    "managerFilePatterns": ["/^clusters/.+\\.yaml(?:\\.j2)?$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^clusters/.+\\.yaml(?:\\.j2)?$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^clusters/.+\\.yaml(?:\\.j2)?$/"]
  },
  "mise": {
    "enabled": true
  },
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Configure Emby versioning",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-operations/emby"],
      "versioning": "loose"
    },
    {
      "description": "Configure Hermes agent versioning (date-based tags)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "versioning": "loose"
    },
    {
      "description": "Auto merge mise tool updates",
      "matchManagers": ["mise"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "description": "continuwuity maxperf builds - pin the suffix so updates stay on the perf build",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["forgejo.ellis.link/continuwuation/continuwuity"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-maxperf$"
    }
  ]
}
