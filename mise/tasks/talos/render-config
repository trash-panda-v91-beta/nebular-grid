#!/usr/bin/env bash
#MISE description="Render Talos config for a node"
#USAGE arg "<node>" help="Node name (e.g. aka, ao, midori)"
set -euo pipefail

TALOS_DIR="$(dirname "$0")/../../../clusters/psb/talos"

IS_CONTROLPLANE=$(minijinja-cli "${TALOS_DIR}/nodes/${usage_node}.yaml.j2" \
  | yq -e 'select(.machine) | (.machine.type == "controlplane") // ""')

export IS_CONTROLPLANE

# The config is one file per concern under talos/all/, concatenated in
# filename order. Splitting keeps each concern small enough to diff on its own
# and matches the document migration - each file is one document, or one
# section of the v1alpha1 config.
talosctl machineconfig patch \
  <(for f in $(ls "${TALOS_DIR}"/all/*.yaml "${TALOS_DIR}"/all/*.yaml.j2 2>/dev/null | sort); do minijinja-cli "$f"; done | op inject) \
  -p @<(minijinja-cli "${TALOS_DIR}/nodes/${usage_node}.yaml.j2" | op inject)
