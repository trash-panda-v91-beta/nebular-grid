---
machine:
  network:
    interfaces:
      # aka
      - deviceSelector:
          busPath: 1-1.0
          driver: thunderbolt-net
        dhcp: false
        mtu: 65520
        addresses:
          - 169.254.255.23/32
        routes:
          - network: 169.254.255.21/32
            metric: 2048
      # midori
      - deviceSelector:
          busPath: 0-1.0
          driver: thunderbolt-net
        dhcp: false
        mtu: 65520
        addresses:
          - 169.254.255.23/32
        routes:
          - network: 169.254.255.22/32
            metric: 2048
  nodeLabels:
    node.kubernetes.io/gpu: "true"
  type: controlplane
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ao.sto.bar.internal
  # UnattendedInstallConfig, matching the base. Talos 1.14 stops validating
  # patches on machine.install, so the node override has to use the typed
  # document too. CEL, not a serial field - disk.serial is the property.
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: 'disk.serial == "S665NN0Y705289"'
