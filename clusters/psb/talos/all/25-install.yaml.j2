---
# UnattendedInstallConfig replaces machine.install. Both the base and the
# per-node patches carried that field, and Talos 1.14 stops validating
# patches on it - so they have to move together or the node patch fails to
# apply. The image lives here, the disk selector is overridden per node.
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/d0403b4a4440e8acf7262d34408e7ecdfd51b3de189db67278d3cce41a25dcf2:v1.14.6
provisioning:
  diskSelector:
    match: 'disk.serial == "PENDING"'
